# Telegram
BOT_TOKEN=123456:ABC-DEF_from_BotFather
BOT_USERNAME=your_bot_username
TELEGRAM_CHAT_ID=-1001234567890

# Публичный URL вашего сервера (без слэша в конце)
# Пример: https://your-app.onrender.com
PUBLIC_BASE_URL=https://your-app.example.com

# Секрет для вебхука Telegram (любая случайная строка)
WEBHOOK_SECRET=change_me_to_random_string

# Robokassa
ROBOKASSA_MERCHANT_LOGIN=your_login
ROBOKASSA_PASSWORD1=password1
ROBOKASSA_PASSWORD2=password2
ROBOKASSA_IS_TEST=1

# Цена товара «доступ в чат» (несколько сумм — через запятую: 990.00,1490.00)
ACCESS_PRICE=990.00

# Страницы курсов на Tilda (покупатели курсов уйдут сюда с общего Success URL)
COURSE_SUCCESS_URL=https://logopedvolgina.ru/success
COURSE_FAIL_URL=https://logopedvolgina.ru/fail

# ResultURL Tilda — наш сервер проксирует сюда уведомления (курсы не ломаются)
TILDA_RESULT_URL=https://forms.tildacdn.com/payment/robokassa/

# SMTP для письма со ссылкой в Telegram (пример — Яндекс)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your@yandex.ru
SMTP_PASSWORD=app_password_here
SMTP_FROM=your@yandex.ru
SMTP_REPLY_TO=your@yandex.ru
SMTP_USE_SSL=1
SMTP_USE_STARTTLS=0

EMAIL_SUBJECT=Ваша ссылка в Telegram-чат — Volgina
AUTO_OPEN_TELEGRAM_SECONDS=4

# База данных
DATABASE_PATH=./data/bot.db

# Сообщения бота
WELCOME_PAID_TEXT=Оплата подтверждена. Вот ваша одноразовая ссылка в закрытый чат (действует ограниченное время):
WELCOME_INVALID_TEXT=Ссылка недействительна или уже использована. Если вы оплатили доступ — напишите в поддержку.
INVITE_EXPIRE_SECONDS=3600
