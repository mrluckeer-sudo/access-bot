# Telegram
BOT_TOKEN=123456:ABC-DEF_from_BotFather
BOT_USERNAME=your_bot_username
TELEGRAM_CHAT_ID=-1001234567890

# Публичный URL вашего сервера (без слэша в конце)
# Пример: https://access-bot.example.ru
PUBLIC_BASE_URL=https://your-app.example.com

# Секрет для вебхука Telegram (любая случайная строка)
WEBHOOK_SECRET=change_me_to_random_string

# CloudPayments (основной провайдер)
# Public ID и API Secret — в ЛК CloudPayments → сайты → настройки
CLOUDPAYMENTS_PUBLIC_ID=pk_xxx
CLOUDPAYMENTS_API_SECRET=your_api_secret
# В CloudPayments укажите уведомления на наш сервер:
#   Check: https://ВАШ_ДОМЕН/cloudpayments/check
#   Pay:   https://ВАШ_ДОМЕН/cloudpayments/pay
# Мы проксируем дальше на Tilda, чтобы курсы работали.
TILDA_CP_CHECK_URL=https://forms.tildacdn.com/payment/cloudpayments/check/
TILDA_CP_PAY_URL=https://forms.tildacdn.com/payment/cloudpayments/pay/

# Цена товара «доступ в чат» (несколько сумм — через запятую: 990.00,1490.00)
ACCESS_PRICE=990.00

# Страницы курсов на Tilda
COURSE_SUCCESS_URL=https://logopedvolgina.ru/success
COURSE_FAIL_URL=https://logopedvolgina.ru/fail

# SMTP / Brevo для письма со ссылкой в Telegram
SMTP_FROM=your@yandex.ru
SMTP_FROM_NAME=Volgina
SMTP_REPLY_TO=your@yandex.ru
BREVO_API_KEY=

EMAIL_SUBJECT=Ваша ссылка в Telegram-чат — Volgina
LEAD_MATCH_MINUTES=60
AUTO_OPEN_TELEGRAM_SECONDS=4

# База данных (на Yandex Cloud VM лучше /data/bot.db с volume)
DATABASE_PATH=./data/bot.db

# Сообщения бота
WELCOME_PAID_TEXT=Оплата подтверждена. Вот ваша одноразовая ссылка в закрытый чат (действует ограниченное время):
WELCOME_INVALID_TEXT=Ссылка недействительна или уже использована. Если вы оплатили доступ — напишите в поддержку.
INVITE_EXPIRE_SECONDS=3600

# --- Legacy Robokassa (не обязательно) ---
# ROBOKASSA_MERCHANT_LOGIN=
# ROBOKASSA_PASSWORD1=
# ROBOKASSA_PASSWORD2=
# ROBOKASSA_IS_TEST=1
